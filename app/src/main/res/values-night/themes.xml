<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night resource overrides keep the native startup window dark without
         relying on the framework day/night Material base style. -->
    <style name="Theme.NeoGPT" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/neo_start_background</item>
        <item name="android:fontFamily">@font/josefin_sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.NeoGPT.Starting" parent="Theme.NeoGPT">
        <item name="android:windowBackground">@color/neo_start_background</item>
    </style>
</resources>
