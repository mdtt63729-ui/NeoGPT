<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeoGPT" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/neo_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/josefin_sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.NeoGPT.Starting" parent="Theme.NeoGPT">
        <item name="android:windowBackground">@color/neo_background</item>
    </style>
</resources>
