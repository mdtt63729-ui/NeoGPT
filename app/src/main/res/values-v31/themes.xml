<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ owns the first window frame. Use the same Neo artwork as the custom
         Compose splash so the framework frame is visually indistinguishable from it. -->
    <style name="Theme.NeoGPT.Starting" parent="Theme.NeoGPT">
        <item name="android:windowBackground">@color/neo_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/neo_background</item>
    </style>
</resources>
